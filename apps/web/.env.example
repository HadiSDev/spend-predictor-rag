# Clerk publishable key — used by the browser (client). Safe to expose; the
# VITE_ prefix ships it to the client bundle. Get it from Clerk → API keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk secret key — used SERVER-SIDE only by clerkMiddleware()/auth() (this app
# does SSR route protection). NO VITE_ prefix, so it is never sent to the
# browser. Same value as the web API's CLERK_SECRET_KEY.
CLERK_SECRET_KEY=sk_test_...

# Base URL of the web API (FastAPI). No trailing slash.
VITE_API_BASE_URL=http://localhost:8100

# Show the "Continue with Google" button on the sign-in page. Only enable this
# when Google OAuth is configured on the Clerk instance. Default: off.
# VITE_CLERK_GOOGLE_OAUTH=true
